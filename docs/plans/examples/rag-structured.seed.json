      "profile": "technical_vector",
      "status": "approximate_reference_reconstruction_not_author_hex_or_IEEE_standard"
    }
  ],
  "tokens": {
    "canvas": "#FFFFFF",
    "ink": "#111111",
    "regions": {"primary": "#E7F5FD", "secondary": "#F3F5F8", "accent": "#F6EEFC"},
    "outlines": {"primary": "#19769D", "secondary": "#3A4759", "accent": "#8034B2"},
    "typography": {"family": {"ref": "publication.fontFamily"}, "bodyPt": {"ref": "publication.bodyPt"}},
